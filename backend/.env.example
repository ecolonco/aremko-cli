# Meta Ads Configuration
META_ACCESS_TOKEN=your_meta_access_token_here
META_AD_ACCOUNT_ID=act_123456789

# Database
DATABASE_URL=postgres://user:password@localhost:5432/aremko?sslmode=disable

# Server
PORT=8080
ENVIRONMENT=development

# Feature Flags
ENABLE_META_ADS=true
ENABLE_GOOGLE_ADS=false
ENABLE_LINKEDIN=false
ENABLE_BOOKINGS=true

# Booking System (Django API)
# Local: http://localhost:8002
# Production: https://www.aremko.cl
BOOKING_SYSTEM_URL=https://www.aremko.cl

