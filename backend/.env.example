# Meta Ads Configuration
META_ACCESS_TOKEN=your_meta_access_token_here

# Lista de cuentas a monitorear (CSV, mismo orden en IDs y labels).
# El brief y el dashboard agregan totales + desglosan por cuenta.
META_AD_ACCOUNT_IDS=act_123456789,act_987654321
META_ACCOUNT_LABELS=Cuenta Principal,Cuenta Nueva

# Legacy singular (se mantiene como fallback si META_AD_ACCOUNT_IDS no está set)
META_AD_ACCOUNT_ID=act_123456789

# Campaña Refugio (vista dedicada en brief/dashboard con Leads/CPL)
META_REFUGIO_CAMPAIGN_ID=
META_REFUGIO_BUDGET_CLP=100000

# Database
DATABASE_URL=postgres://user:password@localhost:5432/aremko?sslmode=disable

# Server
PORT=8080
ENVIRONMENT=development

# Feature Flags
ENABLE_META_ADS=true
ENABLE_GOOGLE_ADS=false
ENABLE_LINKEDIN=false
ENABLE_BOOKINGS=true

# Booking System (Django API)
# Local: http://localhost:8002
# Production: https://www.aremko.cl
BOOKING_SYSTEM_URL=https://www.aremko.cl

# Google Ads (cuenta 539-975-0827, OAuth2 + refresh token)
# Cuando estas 5 vars están presentes, EnableGoogleAds se auto-activa.
# Setup: ver docs/RENDER-GOOGLE-ADS-ENV.md
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=5399750827          # sin guiones
GOOGLE_ADS_LOGIN_CUSTOMER_ID=              # ID del MCC si la cuenta está administrada
GOOGLE_ADS_REFUGIO_CAMPAIGN_ID=            # ID numérico de la campaña Refugio Search
GOOGLE_ADS_BUDGET_CLP=100000

# LinkedIn Ads (Fase 2)
# LINKEDIN_ACCESS_TOKEN=
# LINKEDIN_AD_ACCOUNT_ID=

# WhatsApp Cloud API (piloto inbound Refugio)
# Se obtienen en Meta for Developers → app Aremko-wa → WhatsApp → Configuración de la API
ENABLE_WHATSAPP=false
WHATSAPP_ACCESS_TOKEN=            # token (temporal de prueba o permanente de System User)
WHATSAPP_PHONE_NUMBER_ID=        # Identificador del número de teléfono
WHATSAPP_WABA_ID=                # WhatsApp Business Account ID
WHATSAPP_VERIFY_TOKEN=           # cadena que inventamos; se pega igual en el panel de Meta
WHATSAPP_APP_SECRET=             # App Secret (Configuración de la app → Básica) para validar firmas
